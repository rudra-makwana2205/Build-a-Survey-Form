<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Survey Form</title>
</head>
<body>

  <h1 id="title">Customer Feedback Survey</h1>
  <p id="description">Please take a moment to help us improve our services.</p>

  <form id="survey-form">
    
    <!-- Name Field -->
    <label id="name-label" for="name">Name</label>
    <input 
      type="text" 
      id="name" 
      placeholder="Enter your name" 
      required 
    />
    <br><br>

    <!-- Email Field -->
    <label id="email-label" for="email">Email</label>
    <input 
      type="email" 
      id="email" 
      placeholder="Enter your email" 
      required 
    />
    <br><br>

    <!-- Number Field -->
    <label id="number-label" for="number">Age</label>
    <input 
      type="number" 
      id="number" 
      min="10" 
      max="100" 
      placeholder="Enter your age" 
    />
    <br><br>

    <!-- Dropdown -->
    <label for="dropdown">Which option best describes your current role?</label>
    <select id="dropdown">
      <option value="student">Student</option>
      <option value="job">Full Time Job</option>
      <option value="other">Other</option>
    </select>
    <br><br>

    <!-- Radio Buttons -->
    <p>Would you recommend us to a friend?</p>
    <label>
      <input type="radio" name="recommend" value="definitely" /> Definitely
    </label>
    <label>
      <input type="radio" name="recommend" value="maybe" /> Maybe
    </label>
    <br><br>

    <!-- Checkboxes -->
    <p>What features do you like best?</p>
    <label>
      <input type="checkbox" name="prefer" value="front-end" /> Front-end Projects
    </label>
    <label>
      <input type="checkbox" name="prefer" value="back-end" /> Back-end Projects
    </label>
    <br><br>

    <!-- Textarea -->
    <label for="comments">Any comments or suggestions?</label><br>
    <textarea id="comments" name="comments" placeholder="Enter your feedback here..."></textarea>
    <br><br>

    <!-- Submit Button -->
    <button type="submit" id="submit">Submit</button>

  </form>

</body>
</html>
